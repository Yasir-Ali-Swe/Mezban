generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// USER / BUSINESS
// ============================================================

model User {
  id String @id

  email     String?
  firstName String?
  lastName  String?
  username  String?
  imageUrl  String?

  business Business?
  categoriesCreated Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// BUSINESS
// ============================================================

model Business {
  id String @id @default(cuid())

  userId String @unique

  name     String?
  email    String?
  phone    String?
  address  String?
  city     String?
  country  String?
  website  String?
  imageUrl String?

  onboardingCompleted Boolean @default(false)
  onboardingStep      Int     @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  knowledge BusinessKnowledge?
  hours     BusinessHour[]
  telegram  TelegramConfig?

  categories Category[]
  menuItems  MenuItem[]
  deals      Deal[]

  customers    Customer[]
  orders       Order[]
  reservations Reservation[]

  conversations Conversation[]

  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]

  agentRuns AgentRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================================
// BUSINESS KNOWLEDGE
// ============================================================

model BusinessKnowledge {
  id         String @id @default(cuid())
  businessId String @unique

  businessIdentity       String @db.Text
  foodVariety            String @db.Text
  deliveryInformation    String @db.Text
  paymentInformation     String @db.Text
  reservationInformation String @db.Text

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// BUSINESS HOURS
// ============================================================

model BusinessHour {
  id         String @id @default(cuid())
  businessId String

  dayOfWeek DayOfWeek

  isOpen Boolean @default(true)

  open  String?
  close String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ============================================================
// TELEGRAM
// ============================================================

model TelegramConfig {
  id         String @id @default(cuid())
  businessId String @unique

  botId       String
  botName     String
  botUsername String

  botToken String

  botLink  String
  deepLink String?

  webhookUrl    String?
  webhookSecret String?
  webhookStatus String?

  firstName String?
  lastName  String?
  username  String?
  avatarUrl String?

  isConnected Boolean @default(false)

  connectedAt  DateTime?
  lastUpdateAt DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([botId])
  @@index([botUsername])
}

// ============================================================
// CATEGORY
// ============================================================

model Category {
  id         String @id @default(cuid())
  businessId String
  createdById String?

  name   String
  slug   String
  status CategoryStatus @default(ACTIVE)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  menuItems MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([businessId, status])
  @@index([createdById])
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

// ============================================================
// MENU ITEM
// ============================================================

model MenuItem {
  id         String @id @default(cuid())
  businessId String
  categoryId String

  name        String
  description String? @db.Text

  costPrice    Decimal @db.Decimal(10, 2)
  sellingPrice Decimal @db.Decimal(10, 2)

  imageUrl String?

  status MenuItemStatus @default(AVAILABLE)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  dealItems  DealItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([categoryId])
  @@index([businessId, status])
}

enum MenuItemStatus {
  AVAILABLE
  UNAVAILABLE
}

// ============================================================
// DEAL
// ============================================================

model Deal {
  id         String @id @default(cuid())
  businessId String

  name        String
  description String @db.VarChar(350)

  costPrice    Decimal @db.Decimal(10, 2)
  sellingPrice Decimal @db.Decimal(10, 2)

  imageUrl String?

  status DealStatus @default(ACTIVE)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  items DealItem[]

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, status])
}

enum DealStatus {
  ACTIVE
  INACTIVE
}

// ============================================================
// DEAL ITEM
// ============================================================

model DealItem {
  id         String @id @default(cuid())
  dealId     String
  menuItemId String

  quantity Int

  name      String
  unitPrice Decimal @db.Decimal(10, 2)

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealId, menuItemId])
  @@index([dealId])
  @@index([menuItemId])
}

// ============================================================
// CUSTOMER
// ============================================================

model Customer {
  id         String @id @default(cuid())
  businessId String

  name  String
  phone String?
  email String?

  telegramChatId String
  telegramUserId String?
  username       String?
  firstName      String?
  lastName       String?
  avatarUrl      String?
  languageCode   String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  orders        Order[]
  reservations  Reservation[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, telegramChatId])
  @@index([businessId])
  @@index([businessId, phone])
  @@index([businessId, telegramUserId])
}

// ============================================================
// ORDER
// ============================================================

model Order {
  id         String @id @default(cuid())
  businessId String
  customerId String
  conversationId String?

  orderNumber String

  status    OrderStatus @default(PENDING)
  orderType OrderType   @default(DELIVERY)
  paymentMethod String?
  customerPhone String?

  subtotal Decimal @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  shipping Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  notes String? @db.Text

  shippingStreet  String?
  shippingCity    String?
  shippingState   String?
  shippingZipCode String?
  shippingCountry String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([businessId, customerId])
  @@index([businessId, conversationId])
  @@index([businessId, status])
  @@index([businessId, createdAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
}

// ============================================================
// ORDER ITEM
// ============================================================

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  menuItemId String?
  dealId     String?

  name     String
  imageUrl String?

  quantity Int

  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  deal Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
  @@index([dealId])
}

// ============================================================
// RESERVATION
// ============================================================

model Reservation {
  id         String @id @default(cuid())
  businessId String
  customerId String

  reservationNumber String

  reservationAt DateTime

  guestCount Int

  status ReservationStatus @default(PENDING)

  notes String? @db.Text

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, reservationNumber])
  @@index([businessId])
  @@index([businessId, reservationAt])
  @@index([businessId, status])
  @@index([customerId])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// ============================================================
// CONVERSATION
// ============================================================

model Conversation {
  id         String @id @default(cuid())
  businessId String
  customerId String

  intent String?

  agent AgentType @default(GENERAL_AGENT)

  status ConversationStatus @default(ACTIVE)

  escalationReason String?
  escalationType   String?
  escalationData   Json?

  resolvedByName String?
  resolvedAt     DateTime?

  lastMessage  String?  @db.Text
  lastActivity DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  messages Message[]

  agentRuns AgentRun[]

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, customerId])
  @@index([businessId, status])
  @@index([businessId, lastActivity])
}

// ============================================================
// MESSAGE
// ============================================================

model Message {
  id             String @id @default(cuid())
  conversationId String

  sender    MessageSender
  agentType AgentType?
  senderName String?
  isHuman    Boolean @default(false)

  content String @db.Text

  telegramMessageId String?
  telegramUpdateId  String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId, telegramMessageId])
  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([telegramMessageId])
  @@index([telegramUpdateId])
}

enum MessageSender {
  CUSTOMER
  AGENT
  SYSTEM
}

// ============================================================
// AGENT EXECUTION
// ============================================================

model AgentRun {
  id             String @id @default(cuid())
  businessId     String
  conversationId String

  agent AgentType

  userMessage String @db.Text

  finalResponse String? @db.Text

  status AgentRunStatus @default(RUNNING)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  toolExecutions ToolExecution[]

  @@index([businessId])
  @@index([businessId, conversationId])
  @@index([businessId, startedAt])
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

// ============================================================
// TOOL EXECUTION
// ============================================================

model ToolExecution {
  id String @id @default(cuid())

  agentRunId String

  toolName String

  input  Json?
  output Json?

  status ToolExecutionStatus @default(RUNNING)

  errorMessage String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId])
  @@index([toolName])
}

enum ToolExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
}

// ============================================================
// RAG - KNOWLEDGE DOCUMENT
// ============================================================

model KnowledgeDocument {
  id         String @id @default(cuid())
  businessId String

  type  KnowledgeDocumentType
  title String

  content String @db.Text

  sourceType String?
  sourceId   String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  chunks KnowledgeChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, type])
  @@index([sourceType, sourceId])
}

// ============================================================
// RAG - KNOWLEDGE CHUNK
// ============================================================

model KnowledgeChunk {
  id         String @id @default(cuid())
  businessId String
  documentId String

  content    String @db.Text
  chunkIndex Int

  embedding Unsupported("vector(768)")?

  metadata Json?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, chunkIndex])
  @@index([businessId])
  @@index([documentId])
}

// ============================================================
// RAG DOCUMENT TYPES
// ============================================================

enum KnowledgeDocumentType {
  BUSINESS
  FOOD
  DELIVERY
  PAYMENT
  RESERVATION
  HOURS
}

// ============================================================
// CONVERSATION & AGENTS
// ============================================================

enum ConversationStatus {
  ACTIVE
  RESOLVED
  CLOSED
  ESCALATED
}

enum AgentType {
  GENERAL_AGENT
  ORDER_AGENT
  SUPPORT_AGENT
  RESERVATION_AGENT
}
